# Copy to .env if you like; every value has a default for local development.
PORT=3000
DATABASE_URL=postgres://seatres:seatres@localhost:5432/seatres
# Set to true for hosted databases that require an encrypted connection.
DATABASE_SSL=false
DB_POOL_MAX=40
# How long a request may wait for a database connection before getting 429 "busy".
DB_POOL_WAIT_MS=10000
# REQUIRED when NODE_ENV=production. Signs login tokens.
JWT_SECRET=
# Whoever knows this can ask for an admin token (a stand-in for a real login system).
ADMIN_KEY=demo-admin-key
TOKEN_TTL_SECONDS=43200
LOG_LEVEL=info
